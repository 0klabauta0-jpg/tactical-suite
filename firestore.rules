rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function hasRoomClaim(roomId) {
      return request.auth != null
        && request.auth.token.authVersion == 1
        && request.auth.token.roomId == roomId
        && request.auth.token.playerId is string;
    }

    function memberPath(roomId) {
      return /databases/$(database)/documents/rooms/$(roomId)/members/$(request.auth.uid);
    }

    function isRoomMember(roomId) {
      return hasRoomClaim(roomId)
        && exists(memberPath(roomId))
        && get(memberPath(roomId)).data.playerId == request.auth.token.playerId
        && get(memberPath(roomId)).data.authVersion == 1;
    }

    function canWriteBoard(roomId) {
      return isRoomMember(roomId)
        && get(memberPath(roomId)).data.role in ['admin', 'commander'];
    }

    function createsNoTokenFields() {
      return !request.resource.data.keys().hasAny(['tokens', 'tokensBySystem']);
    }

    function keepsTokenFieldsUnchanged() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['tokens', 'tokensBySystem']);
    }

    match /rooms/{roomId} {
      allow list: if true;
      allow create, update, delete: if false;

      match /config/main {
        allow get: if true;
        allow list, create, update, delete: if false;
      }

      match /config/playerOverrides {
        allow read: if isRoomMember(roomId);
        allow create, update: if canWriteBoard(roomId);
        allow delete: if false;
      }

      match /members/{uid} {
        allow read: if isRoomMember(roomId) && request.auth.uid == uid;
        allow write: if false;
      }

      match /roles/{playerId} {
        allow read, write: if false;
      }

      match /private/{document=**} {
        allow read, write: if false;
      }

      match /state/board {
        allow read: if isRoomMember(roomId);
        allow create: if canWriteBoard(roomId) && createsNoTokenFields();
        allow update: if canWriteBoard(roomId) && keepsTokenFieldsUnchanged();
        allow delete: if false;
      }

      match /tokenTransferOperations/{operationId} {
        allow read, write: if false;
      }

      match /playerStatus/{playerId} {
        allow read: if isRoomMember(roomId);
        allow write: if false;
      }

      match /mobileLinks/{playerId} {
        allow read, write: if false;
      }

      match /mapScenes/{sceneId} {
        allow read: if isRoomMember(roomId);
        allow write: if false;

        match /objects/{objectId} {
          allow read: if isRoomMember(roomId);
          allow write: if false;
        }
      }

      match /{document=**} {
        allow read, write: if false;
      }
    }
  }
}
